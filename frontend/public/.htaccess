# La Casa Nostra — configuración para hosting Apache (public_html).
# Va dentro de dist/ tras `npm run build`. Súbelo junto al resto de archivos.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS (actívalo cuando el certificado SSL esté instalado en el hosting).
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA: cualquier ruta que no sea un archivo real (/carta, /reservar...) → index.html
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Caché: los archivos de /assets llevan hash en el nombre → caché larga.
# index.html nunca se cachea para que los cambios se vean al momento.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
